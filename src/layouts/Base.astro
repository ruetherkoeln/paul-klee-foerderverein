---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site.ts';

const { title = SITE.name, description = SITE.description, variant = 'school' } = Astro.props;
const fullTitle = title === SITE.name ? title : `${title} · ${SITE.shortName}`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class={variant === 'verein' ? 'bg-navy-900 text-white' : 'bg-cream-50 text-navy-900'}>
    <Header variant={variant} />
    <main><slot /></main>
    <Footer />
  </body>
</html>

---
// Piktogramm: Martinslaterne. Erste eigene Grafik im Projekt — daher bewusst
// als Inline-SVG und nicht als Bilddatei: so faerbt sie der Bügel ueber
// `currentColor` mit, bleibt bei jeder Groesse scharf und laedt keine
// zusaetzliche Datei (die CSP erlaubt img-src nur 'self' und data:).
//
// Farben ausschliesslich aus der Logopalette (tailwind.config.mjs):
//   Korpus  pk-yellow #e0a836 · Lichtfeld gold-400 #f5c042
//   Deckel/Boden pk-red #b13830 · Stern cream-50 #faf6ef
const { class: klasse = 'w-10 h-12' } = Astro.props;
---
<svg
  class={klasse}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-hidden="true"
  focusable="false"
>
  {/* Bügel und Aufhaenger — nehmen die Textfarbe an */}
  <path
    d="M15 13C15 7.5 19 4.5 24 4.5S33 7.5 33 13"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
  />
  <path d="M24 4.5V11" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />

  {/* Deckel */}
  <path d="M12 12.5h24v4.5H12z" fill="#b13830" />

  {/* Korpus, leicht bauchig */}
  <path
    d="M14.5 17h19l2 10.5-2 11.5h-19l-2-11.5z"
    fill="#e0a836"
  />
  {/* Lichtfeld: innen heller, als brenne die Kerze */}
  <path
    d="M17.5 20h13l1.4 7.5-1.4 8.5h-13L16.1 27.5z"
    fill="#f5c042"
  />
  {/* Stern im Lichtfeld */}
  <path
    d="M24 21.5l2.3 5.1 5.1 1.4-5.1 1.4L24 34.5l-2.3-5.1-5.1-1.4 5.1-1.4z"
    fill="#faf6ef"
  />

  {/* Boden */}
  <path d="M13 39h22v4.5H13z" fill="#b13830" />
</svg>

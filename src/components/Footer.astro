---
import { SITE } from '../data/site.ts';
---
<footer class="bg-navy-900 text-white/80 mt-24">
  <div class="container-c py-14 grid md:grid-cols-3 gap-10">
    <div>
      <div class="flex items-center gap-3 mb-3">
        <img src={SITE.school.logo} alt="" class="w-10 h-auto" width="40" />
        <div class="font-display font-bold text-lg text-white leading-tight">
          Förderverein Paul-Klee-Schule<br/>Düsseldorf e. V.
        </div>
      </div>
      <p class="text-sm leading-relaxed">
        {SITE.address.street}<br/>
        {SITE.address.zip} {SITE.address.city}
      </p>
      <p class="text-sm mt-3">
        E-Mail: <a href={`mailto:${SITE.email}`} class="hover:text-gold-500">{SITE.email}</a>
      </p>
      <a href="/foerderverein/#spenden" class="btn-gold mt-4 !py-2 !px-4 text-xs">Jetzt spenden</a>
    </div>
    <div>
      <div class="font-display font-bold text-lg text-white mb-3">Die Schule, die wir unterstützen</div>
      <p class="text-sm leading-relaxed">
        {SITE.school.fullName}<br/>
        {SITE.school.address.street}<br/>
        {SITE.school.address.zip} {SITE.school.address.city}
      </p>
      <p class="text-sm mt-3">
        Tel.: {SITE.school.phone}<br/>
        E-Mail: <a href={`mailto:${SITE.school.email}`} class="hover:text-gold-500">{SITE.school.email}</a>
      </p>
      <p class="text-sm mt-3">
        Schulwebsite: <a href={SITE.school.website} target="_blank" rel="noopener" class="hover:text-gold-500 underline">grundschule-paul-klee.de</a>
      </p>
    </div>
    <div>
      <div class="font-display font-bold text-lg text-white mb-3">Rechtliches</div>
      <ul class="text-sm space-y-2">
        <li><a href="/impressum/" class="hover:text-gold-500">Impressum</a></li>
        <li><a href="/datenschutz/" class="hover:text-gold-500">Datenschutz</a></li>
        <li><a href="/foerderverein/satzung/" class="hover:text-gold-500">Vereinssatzung</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-c py-4 text-xs flex flex-col md:flex-row justify-between gap-2">
      <span>© {new Date().getFullYear()} {SITE.name}</span>
      <span>Bildung ist kein Privileg.</span>
    </div>
  </div>
</footer>

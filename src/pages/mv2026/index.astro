---
// Geschützter Bereich zur außerordentlichen Mitgliederversammlung.
//
// Die Seite rendert serverseitig, weil sie das Cookie prüfen und das
// Anmeldeformular entgegennehmen muss. Sie steht nicht im Suchindex und ist
// nirgends verlinkt ausser über den Knopf auf der Startseite.
import Base from '../../layouts/Base.astro';
import { VERSAMMLUNG } from '../../data/mv2026.ts';
import { eintraege, lesbareGroesse } from '../../lib/mv2026-unterlagen.ts';
import {
  COOKIE, COOKIE_OPTIONEN, merkmalErzeugen, merkmalGueltig, passwortStimmt,
} from '../../lib/mv2026.ts';

export const prerender = false;

let fehler = '';
let abgemeldet = false;

if (Astro.request.method === 'POST') {
  const formular = await Astro.request.formData();

  if (formular.get('abmelden')) {
    Astro.cookies.delete(COOKIE, { path: '/' });
    abgemeldet = true;
  } else if (passwortStimmt(String(formular.get('passwort') ?? ''))) {
    // Fehlt der Signierschlüssel, wirft das Erzeugen. Ohne diesen Fang stünde
    // hier eine nackte Fehlerseite — ausgerechnet für jemanden, der das
    // richtige Passwort eingegeben hat.
    try {
      Astro.cookies.set(COOKIE, merkmalErzeugen(), COOKIE_OPTIONEN);
      // Nach dem Anmelden umleiten, damit ein Neuladen die Eingabe nicht
      // erneut abschickt und das Passwort nicht im Verlauf hängen bleibt.
      return Astro.redirect('/mv2026/', 303);
    } catch (e) {
      console.error('MV2026: Zugang nicht eingerichtet —', (e as Error).message);
      fehler = 'Der Zugang ist gerade nicht eingerichtet. Bitte melden Sie sich '
        + 'kurz unter info@pks-foerderverein.de, wir kümmern uns sofort darum.';
    }
  } else {
    // Kurz bremsen: macht das Durchprobieren spürbar langsamer, ohne dass
    // jemand mit dem richtigen Passwort etwas merkt.
    await new Promise((f) => setTimeout(f, 600));
    fehler = String(formular.get('passwort') ?? '').trim()
      ? 'Das Passwort stimmt nicht. Bitte prüfen Sie Gross- und Kleinschreibung.'
      : 'Bitte geben Sie das Passwort ein.';
  }
}

const offen = !abgemeldet && merkmalGueltig(Astro.cookies.get(COOKIE)?.value);
const unterlagen = offen ? eintraege() : [];
const bereit = unterlagen.filter((u) => u.vorhanden);
const folgen = unterlagen.filter((u) => !u.vorhanden);

const angaben = [
  VERSAMMLUNG.datum && { was: 'Termin', wert: VERSAMMLUNG.datum },
  VERSAMMLUNG.uhrzeit && { was: 'Beginn', wert: VERSAMMLUNG.uhrzeit },
  VERSAMMLUNG.ort && { was: 'Ort', wert: VERSAMMLUNG.ort },
].filter(Boolean) as { was: string; wert: string }[];
---

<Base title={VERSAMMLUNG.kurz} robots="noindex, nofollow">

  <section class="bg-cream-50 pt-16 pb-10">
    <div class="container-c max-w-3xl">
      <div class="eyebrow mb-4">Nur für Mitglieder</div>
      <h1 class="text-4xl md:text-5xl font-display font-bold leading-tight">
        {VERSAMMLUNG.titel}.
      </h1>

      {!offen && (
        <p class="mt-6 text-lg leading-relaxed text-navy-900/80">
          Die Unterlagen zur Versammlung sind den Mitgliedern des Fördervereins
          vorbehalten. Das Passwort finden Sie in der Einladung, die Sie von uns
          erhalten haben.
        </p>
      )}

      {offen && (
        <p class="mt-6 text-lg leading-relaxed text-navy-900/80">
          Hier finden Sie die Einladung mit der Tagesordnung, das Vollmachtsformular
          und die weiteren Unterlagen zur Versammlung.
        </p>
      )}
    </div>
  </section>

  {!offen && (
    <section class="bg-cream-50">
      <div class="container-c border-t border-navy-900/10 py-12 max-w-3xl">

        {abgemeldet && (
          <div class="mb-8 bg-white border border-navy-900/10 border-l-4 border-l-pk-yellow p-5">
            <p class="text-sm leading-relaxed">
              Sie sind abgemeldet. Um die Unterlagen erneut zu öffnen, geben Sie
              bitte wieder das Passwort ein.
            </p>
          </div>
        )}

        <form method="POST" class="bg-white border border-navy-900/10 p-6 md:p-8 max-w-md">
          <label for="passwort" class="block text-sm font-semibold uppercase tracking-wider text-navy-900/70">
            Passwort
          </label>
          <input
            id="passwort"
            name="passwort"
            type="password"
            autocomplete="current-password"
            autocapitalize="none"
            autocorrect="off"
            spellcheck="false"
            required
            aria-describedby={fehler ? 'passwort-fehler' : undefined}
            aria-invalid={fehler ? 'true' : undefined}
            class="mt-2 w-full border border-navy-900/20 px-4 py-3 text-lg focus:outline-none focus:border-navy-900"
          />

          {fehler && (
            <p id="passwort-fehler" role="alert" class="mt-3 text-sm font-semibold" style="color:#c2185b">
              {fehler}
            </p>
          )}

          <button type="submit" class="btn-dark mt-6 w-full">Unterlagen öffnen</button>
        </form>

        <p class="mt-8 text-sm leading-relaxed text-navy-900/60 max-w-md">
          Passwort nicht zur Hand? Schreiben Sie uns an
          <a href="mailto:info@pks-foerderverein.de" class="underline hover:text-navy-900">
            info@pks-foerderverein.de</a>, wir senden es Ihnen erneut zu.
        </p>
      </div>
    </section>
  )}

  {offen && (
    <section class="bg-cream-50">
      <div class="container-c border-t border-navy-900/10 py-12 max-w-3xl">

        {angaben.length > 0 && (
          <div class="mb-10 grid sm:grid-cols-3 gap-3">
            {angaben.map((a) => (
              <div class="bg-white p-5 border border-navy-900/10 border-l-4 border-l-pk-yellow">
                <div class="text-xs uppercase tracking-wider text-navy-900/60 font-semibold mb-2">
                  {a.was}
                </div>
                <div class="text-sm">{a.wert}</div>
              </div>
            ))}
          </div>
        )}

        <h2 class="text-2xl font-display font-bold">Unterlagen</h2>

        {bereit.length === 0 && (
          <p class="mt-6 leading-relaxed text-navy-900/80">
            Die Unterlagen werden derzeit zusammengestellt und hier eingestellt,
            sobald sie vorliegen. Bitte schauen Sie in den kommenden Tagen noch
            einmal herein.
          </p>
        )}

        {bereit.length > 0 && (
          <ul class="mt-6 space-y-3">
            {bereit.map((u) => (
              <li>
                <a
                  href={`/mv2026/datei/${encodeURIComponent(u.datei)}`}
                  class="group flex items-start gap-4 bg-white p-5 border border-navy-900/10 hover:border-navy-900/40 transition-colors"
                >
                  <span aria-hidden="true" class="text-gold-600 text-xl leading-none mt-0.5">↓</span>
                  <span class="flex-1">
                    <span class="block font-semibold group-hover:text-gold-600 transition-colors">
                      {u.titel}
                    </span>
                    {u.hinweis && (
                      <span class="block mt-1 text-sm leading-relaxed text-navy-900/70">
                        {u.hinweis}
                      </span>
                    )}
                    <span class="block mt-2 text-xs uppercase tracking-wider text-navy-900/50">
                      {u.datei.split('.').pop()?.toUpperCase()} · {lesbareGroesse(u.groesse)}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}

        {folgen.length > 0 && (
          <div class="mt-10">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-navy-900/60">
              Folgt in Kürze
            </h3>
            <ul class="mt-3 space-y-2">
              {folgen.map((u) => (
                <li class="bg-white/60 p-4 border border-dashed border-navy-900/20 text-navy-900/60">
                  <span class="font-semibold">{u.titel}</span>
                  {u.hinweis && <span class="block mt-1 text-sm leading-relaxed">{u.hinweis}</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="mt-12 border-t border-navy-900/10 pt-6 flex flex-wrap items-center gap-4">
          <form method="POST">
            <input type="hidden" name="abmelden" value="1" />
            <button type="submit" class="text-sm underline text-navy-900/60 hover:text-navy-900">
              Abmelden
            </button>
          </form>
          <span class="text-sm text-navy-900/50">
            Der Zugang bleibt zwölf Stunden bestehen.
          </span>
        </div>
      </div>
    </section>
  )}

</Base>

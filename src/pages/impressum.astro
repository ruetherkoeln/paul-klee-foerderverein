---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site.ts';
---
<Base title="Impressum">
  <section class="bg-cream-50 pt-16 pb-10">
    <div class="container-c max-w-3xl">
      <div class="eyebrow mb-4">Rechtliches</div>
      <h1 class="text-4xl md:text-5xl font-display font-bold">Impressum.</h1>
    </div>
  </section>

  <section class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-12 max-w-3xl space-y-10">
      <div>
        <div class="eyebrow mb-2">Diensteanbieter</div>
        <h2 class="font-display font-bold text-2xl">Förderverein</h2>
        <p class="mt-4 leading-relaxed text-navy-900/80">
          Förderverein der Paul-Klee-Schule Düsseldorf e. V.<br/>
          {SITE.address.street}<br/>
          {SITE.address.zip} {SITE.address.city}<br/>
          E-Mail: <a href={`mailto:${SITE.email}`} class="text-pk-red hover:underline">{SITE.email}</a>
        </p>
        <p class="mt-4 leading-relaxed text-sm text-navy-900/70">
          Vereinsregister: VR 7008 — Amtsgericht Düsseldorf.<br/>
          Steuerlich anerkannt als gemeinnützig (Freistellungsbescheid 2021).<br/>
          Vertreten durch den Vorstand gemäß § 26 BGB.
        </p>
      </div>

      <div class="border-t border-navy-900/10 pt-10">
        <div class="eyebrow mb-2">Schule, die wir unterstützen</div>
        <h2 class="font-display font-bold text-2xl">Paul-Klee-Schule</h2>
        <p class="mt-4 leading-relaxed text-navy-900/80">
          {SITE.school.fullName}<br/>
          Schulleitung: Maike Dambeck<br/>
          {SITE.school.address.street}, {SITE.school.address.zip} {SITE.school.address.city}<br/>
          Tel.: {SITE.school.phone} · Fax: {SITE.school.fax}<br/>
          E-Mail: <a href={`mailto:${SITE.school.email}`} class="text-pk-red hover:underline">{SITE.school.email}</a>
        </p>
        <p class="mt-4 leading-relaxed text-sm text-navy-900/70">
          Eine eigene Webpräsenz pflegt die Schule unter
          <a href={SITE.school.website} target="_blank" rel="noopener" class="text-pk-red hover:underline">grundschule-paul-klee.de</a>.
          Sie wird durch die Schulleitung gesetzlich vertreten.
        </p>
      </div>

      <div class="border-t border-navy-900/10 pt-10">
        <h2 class="font-display font-bold text-2xl">Schulträger</h2>
        <p class="mt-4 leading-relaxed text-navy-900/80">
          Landeshauptstadt Düsseldorf<br/>
          vertreten durch den Oberbürgermeister<br/>
          Marktplatz 2, 40213 Düsseldorf<br/>
          E-Mail: <a href="mailto:info@duesseldorf.de" class="text-pk-red hover:underline">info@duesseldorf.de</a>
        </p>
      </div>

      <div class="border-t border-navy-900/10 pt-10">
        <h2 class="font-display font-bold text-2xl">Urheberrecht</h2>
        <p class="mt-4 leading-relaxed text-sm text-navy-900/70">
          Texte, Bilder, Grafiken und die Gestaltung dieser Internetseiten unterliegen dem Urheberrecht.
          Sie dürfen nur zum privaten und sonstigen eigenen Gebrauch im Rahmen des § 53 UrhG ohne jede
          Änderung vervielfältigt werden. Eine darüber hinausgehende Verbreitung ist nur mit schriftlicher
          Genehmigung zulässig. Das Logo der Paul-Klee-Schule wird mit Erlaubnis der Schule verwendet.
        </p>
      </div>

      <div class="border-t border-navy-900/10 pt-10">
        <h2 class="font-display font-bold text-2xl">Haftung für Inhalte</h2>
        <p class="mt-4 leading-relaxed text-sm text-navy-900/70">
          Die Informationen wurden nach bestem Wissen und Gewissen sorgfältig zusammengestellt und geprüft.
          Für Richtigkeit, Vollständigkeit, Aktualität oder Qualität wird keine Gewähr übernommen.
          Diensteanbieter sind gemäß § 7 Abs. 1 TMG für eigene Inhalte verantwortlich.
        </p>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site.ts';

const foerderbereiche = [
  {
    kicker: '01',
    title: 'Lernmittel & Ausstattung',
    body: 'Schulhefte, Stifte, Taschenrechner — für Kinder, deren Familien sich das Nötigste nicht leisten können.'
  },
  {
    kicker: '02',
    title: 'Klassenfahrten & Ausflüge',
    body: 'Bezuschussung von Klassenfahrten und Ausflügen für Familien ohne die nötigen Mittel.'
  },
  {
    kicker: '03',
    title: 'Frühstück & Grundversorgung',
    body: 'Kofinanzierung von Frühstücksangeboten und Grundversorgung im Schulalltag.'
  },
  {
    kicker: '04',
    title: 'Digitale Teilhabe',
    body: 'Tablets, Lernsoftware, Druckerpatronen — damit kein Kind beim digitalen Lernen abgehängt wird.'
  },
  {
    kicker: '05',
    title: 'Musik, Kunst & Sport',
    body: 'Instrumente, Sporttrikots, Workshops — Angebote jenseits des Regelbudgets.'
  },
  {
    kicker: '06',
    title: 'Schulverschönerung',
    body: 'Räume, Pausenhof, Garten — Beiträge zu einer Umgebung, in der Kinder gern lernen.'
  }
];

const kennzahlen = [
  { value: '~220', label: 'Kinder an der Schule' },
  { value: '8', label: 'Klassen, 2 pro Jahrgang' },
  { value: '30+', label: 'Herkunftsländer der Familien' },
  { value: '100 %', label: 'Mittel direkt an die Kinder' }
];
---
<Base title="Förderverein der Paul-Klee-Schule Düsseldorf" description={SITE.description}>

  {/* HERO */}
  <section class="bg-cream-50 pt-16 pb-14">
    <div class="container-c grid md:grid-cols-[1.5fr_1fr] gap-12 items-start">
      <div>
        <div class="eyebrow mb-4">Förderverein · gemeinnützig · gestaltend</div>
        <h1 class="text-4xl md:text-5xl font-display font-bold leading-tight">
          Förderverein der<br/>Paul-Klee-Schule Düsseldorf e. V.
        </h1>
        <p class="mt-6 text-lg leading-relaxed max-w-2xl text-navy-900/80">
          Wir unterstützen die Städt. Katholische Grundschule Paul-Klee in
          Düsseldorf-Zentrum unter anderem mit Lernmitteln, Klassenfahrten,
          Frühstück und digitaler Teilhabe für rund 220 Kinder.
        </p>
        <p class="mt-4 text-lg leading-relaxed max-w-2xl text-navy-900/80">
          Bedingt durch die Lage der Schule und die Zusammensetzung der
          Schülerschaft sind zusätzlich zum Schulalltag besondere
          Herausforderungen zur Teilhabe aller Schüler zu leisten.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/foerderverein/#spenden" class="btn-dark">Jetzt spenden</a>
          <a href="/foerderverein/mitglied-werden/" class="btn-ghost">Mitglied werden</a>
        </div>
      </div>
      <a href="/schule/" class="block bg-white p-8 border border-navy-900/10 hover:border-navy-900/30 transition-colors text-center">
        <img
          src={SITE.school.logo}
          alt="Logo der Paul-Klee-Schule Düsseldorf"
          class="max-w-[140px] mx-auto h-auto"
          width="140"
        />
        <div class="mt-5 text-xs uppercase tracking-wider text-navy-900/60">
          Die Schule, die wir unterstützen
        </div>
        <div class="mt-1 font-display font-semibold text-navy-900">
          Paul-Klee-Schule
        </div>
      </a>
    </div>
  </section>

  {/* KENNZAHLEN */}
  <section class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-12 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {kennzahlen.map(k => (
        <div>
          <div class="text-3xl md:text-4xl font-display font-bold text-navy-900">{k.value}</div>
          <div class="mt-2 text-sm text-navy-900/60">{k.label}</div>
        </div>
      ))}
    </div>
  </section>

  {/* WAS WIR TUN */}
  <section class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-16">
      <div class="eyebrow mb-3">Unsere Förderbereiche</div>
      <h2 class="text-3xl md:text-4xl font-display font-bold mb-10">Was wir tun.</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {foerderbereiche.map(p => (
          <div class="bg-white p-6 border border-navy-900/10">
            <div class="text-xs text-gold-600 font-semibold tracking-wider">{p.kicker}</div>
            <h3 class="mt-2 text-lg font-display font-semibold">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-navy-900/75">{p.body}</p>
          </div>
        ))}
      </div>
      <div class="mt-10">
        <a href="/foerderverein/#projekte" class="text-gold-600 font-semibold hover:underline">Alle Projekte und Vorhaben ansehen →</a>
      </div>
    </div>
  </section>

  {/* DIE SCHULE — ZUSAMMENFASSUNG */}
  <section class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-16">
      <div class="eyebrow mb-3">Hintergrund</div>
      <h2 class="text-3xl md:text-4xl font-display font-bold mb-6">Die Schule, die wir unterstützen.</h2>
      <p class="text-lg leading-relaxed max-w-3xl text-navy-900/80">
        Die {SITE.school.fullName} ist eine offene Ganztagsschule mit rund 220 Kindern in
        acht Klassen — zwei pro Jahrgang. Trägerin des Ganztags ist Flingern mobil e. V.
        Das Schulgebäude an der Gerresheimer Straße wurde 1907 erbaut und in den vergangenen
        Jahren umfassend saniert.
      </p>
      <p class="mt-4 text-lg leading-relaxed max-w-3xl text-navy-900/80">
        Inhalte zu Unterricht, Anmeldung, Team und Schulalltag pflegt die Schule selbst.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={SITE.school.website} target="_blank" rel="noopener" class="btn-ghost">Zur Schulwebsite</a>
        <a href="/schule/" class="btn border-2 border-transparent text-navy-900 underline underline-offset-4 hover:text-gold-600">Wer wir sind</a>
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-16 text-center">
      <h2 class="text-3xl md:text-4xl font-display font-bold max-w-2xl mx-auto">Werden Sie Teil unserer Arbeit.</h2>
      <p class="mt-4 text-navy-900/75 max-w-xl mx-auto leading-relaxed">
        Mitgliedschaft ab 12 € im Jahr. Spenden ab dem ersten Cent.
        Gemeinnützig anerkannt — Spendenquittung auf Anfrage.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/foerderverein/#spenden" class="btn-dark">Jetzt spenden</a>
        <a href="/foerderverein/mitglied-werden/" class="btn-ghost">Mitglied werden</a>
      </div>
    </div>
  </section>
</Base>

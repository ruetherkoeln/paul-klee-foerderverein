---
import Base from '../../../layouts/Base.astro';
---
<Base title="Anmeldetermine Einschulung 2027/2028">
  <section class="bg-cream-50 pt-16 pb-10">
    <div class="container-c">
      <div class="eyebrow mb-4">Anmeldung</div>
      <h1 class="text-4xl font-display font-extrabold max-w-3xl">Anmeldetermine — Einschulung 2027/2028</h1>
      <p class="mt-4 max-w-2xl">Konkrete Termine werden rechtzeitig durch das Schulamt der Stadt Düsseldorf bekanntgegeben. Für Rückfragen: Sekretariat 0211 / 89 23 752.</p>
    </div>
  </section>
</Base>

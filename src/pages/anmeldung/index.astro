---
import Base from '../../layouts/Base.astro';
---
<Base title="Anmeldung">
  <section class="bg-cream-50 pt-16 pb-10">
    <div class="container-c">
      <div class="eyebrow mb-4">Einschulung</div>
      <h1 class="text-5xl font-display font-extrabold">Anmeldung.</h1>
      <p class="mt-4 max-w-2xl leading-relaxed">
        Sie überlegen, Ihr Kind an unserer Schule anzumelden? Wir freuen uns auf Sie und Ihre Familie.
      </p>
    </div>
  </section>
  <section class="bg-cream-50 pb-16">
    <div class="container-c grid md:grid-cols-2 gap-6">
      <a href="/anmeldung/anmeldetermine-einschulung-2027-2028/" class="card hover:border-gold-500">
        <div class="eyebrow mb-2">Einschulung 2027/2028</div>
        <div class="font-display font-bold text-2xl">Anmeldetermine</div>
        <p class="mt-2 text-sm text-navy-900/70">Termine und Ablauf der Anmeldung für die Einschulung 2027/2028.</p>
        <div class="mt-4 text-gold-600 font-semibold text-sm">Mehr erfahren →</div>
      </a>
      <a href="/anmeldung/neu-in-duesseldorf/" class="card hover:border-gold-500">
        <div class="eyebrow mb-2">Neu in Düsseldorf?</div>
        <div class="font-display font-bold text-2xl">Quereinstieg</div>
        <p class="mt-2 text-sm text-navy-900/70">Information für Familien, die während des Schuljahres zuziehen.</p>
        <div class="mt-4 text-gold-600 font-semibold text-sm">Mehr erfahren →</div>
      </a>
    </div>
  </section>
</Base>

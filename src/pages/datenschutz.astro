---
import Base from '../layouts/Base.astro';
---
<Base title="Datenschutzerklärung">
  <section class="bg-cream-50 pt-16 pb-10">
    <div class="container-c max-w-3xl">
      <h1 class="text-5xl font-display font-extrabold">Datenschutz.</h1>
      <p class="mt-4 text-navy-900/70 text-sm">
        Die Datenschutzerklärung wird derzeit überarbeitet und in Kürze hier veröffentlicht.
        Bis dahin gelten die Datenschutzbestimmungen der Stadt Düsseldorf sowie die DSGVO.
      </p>
    </div>
  </section>
</Base>

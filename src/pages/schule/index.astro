---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site.ts';
---
<Base title="Die Schule, die wir unterstützen" description="Die Paul-Klee-Grundschule in Düsseldorf-Zentrum — Träger der Bildungsarbeit, die unser Förderverein unterstützt.">

  {/* HERO */}
  <section class="bg-cream-50 pt-16 pb-14">
    <div class="container-c grid md:grid-cols-[1.5fr_1fr] gap-12 items-start">
      <div>
        <div class="eyebrow mb-4">Wer steht hinter unserer Arbeit</div>
        <h1 class="text-4xl md:text-5xl font-display font-bold leading-tight">
          Die Schule, die wir unterstützen.
        </h1>
        <p class="mt-6 text-lg leading-relaxed max-w-2xl text-navy-900/80">
          Wir sind nicht die Schule — wir sind der Förderverein. Unsere Arbeit
          ist seit 2004 zu 100 % auf eine Aufgabe fokussiert: die {SITE.school.fullName}
          im Herzen von Düsseldorf.
        </p>
        <p class="mt-4 text-lg leading-relaxed max-w-2xl text-navy-900/80">
          Die Schule und die Stadt haben sich im Laufe der Jahre verändert. Neue
          Herausforderungen sind entstanden: für die Lehrer, für die Schule, für die Schüler.
        </p>
        <p class="mt-4 text-lg leading-relaxed max-w-2xl text-navy-900/80">
          In den 70er Jahren erfand der Deutsche Städtetag den Begriff „Brennpunktschule".
          Man kann den Begriff ablehnen, jedoch erfordern die tatsächlichen Umstände
          des Alltags neue Konzepte.
        </p>
        <p class="mt-4 text-lg leading-relaxed max-w-2xl text-navy-900/80">
          Bildung ist das wertvollste Gut, das wir unseren Kindern mitgeben können.
          Gerade in der Grundschule werden die entscheidenden Fundamente gelegt:
          Hier lernen Kinder Neugier, Selbstvertrauen und die Freude am Lernen. Was
          in diesen ersten Jahren angelegt wird, prägt den weiteren Bildungsweg
          nachhaltig und schafft die Basis für eine erfolgreiche Zukunft.
        </p>
        <p class="mt-4 text-lg leading-relaxed max-w-2xl text-navy-900/80">
          Genau hierbei unterstützen wir die Schule.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={SITE.school.website} target="_blank" rel="noopener" class="btn-dark">Zur Schulwebsite</a>
          <a href="/foerderverein/" class="btn-ghost">Was wir tun</a>
        </div>
      </div>
      <a href={SITE.school.website} target="_blank" rel="noopener" class="block bg-white p-8 border border-navy-900/10 hover:border-navy-900/30 transition-colors text-center">
        <img
          src={SITE.school.logo}
          alt={`Logo der ${SITE.school.fullName}`}
          class="max-w-[200px] mx-auto h-auto"
          width="200"
        />
        <div class="mt-5 text-xs uppercase tracking-wider text-navy-900/60">
          Offizielle Schulwebsite
        </div>
        <div class="mt-1 font-display font-semibold text-navy-900">
          grundschule-paul-klee.de
        </div>
      </a>
    </div>
  </section>

  {/* KENNZAHLEN */}
  <section class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-12 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div>
        <div class="text-3xl md:text-4xl font-display font-bold text-navy-900">~220</div>
        <div class="mt-2 text-sm text-navy-900/60">Kinder, die wir mittragen</div>
      </div>
      <div>
        <div class="text-3xl md:text-4xl font-display font-bold text-navy-900">8</div>
        <div class="mt-2 text-sm text-navy-900/60">Klassen, 2 pro Jahrgang</div>
      </div>
      <div>
        <div class="text-3xl md:text-4xl font-display font-bold text-navy-900">30+</div>
        <div class="mt-2 text-sm text-navy-900/60">Herkunftsländer der Familien</div>
      </div>
      <div>
        <div class="text-3xl md:text-4xl font-display font-bold text-navy-900">1907</div>
        <div class="mt-2 text-sm text-navy-900/60">Baujahr des Schulgebäudes</div>
      </div>
    </div>
  </section>

  {/* PROFIL */}
  <section class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-16">
      <div class="eyebrow mb-3">Kurzprofil</div>
      <h2 class="text-3xl md:text-4xl font-display font-bold mb-6">Eine offene Ganztagsschule mit Charakter.</h2>
      <p class="text-lg leading-relaxed max-w-3xl text-navy-900/80">
        Die Paul-Klee-Schule ist eine städtisch katholische Grundschule mit rund 220 Kindern,
        zwei Klassen pro Jahrgang, einem Schulgebäude von 1907 und einer der vielfältigsten
        Schülerschaften der Stadt. Trägerin des offenen Ganztags ist Flingern mobil e. V.
      </p>
      <p class="mt-4 text-lg leading-relaxed max-w-3xl text-navy-900/80">
        Diese Vielfalt — und der Bedarf, der mit ihr einhergeht — macht unsere Förderarbeit
        notwendig: Lernmittel für Familien ohne Reserven, Klassenfahrten ohne Aussiebung,
        Frühstück ohne Stigma, digitale Teilhabe ohne Sondersteuer.
      </p>
    </div>
  </section>

  {/* CTA */}
  <section class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-16 text-center">
      <h2 class="text-3xl md:text-4xl font-display font-bold max-w-2xl mx-auto">Werden Sie Teil unserer Arbeit.</h2>
      <p class="mt-4 text-navy-900/75 max-w-xl mx-auto leading-relaxed">
        Mitgliedschaft ab 12 € im Jahr. Spenden ab dem ersten Cent.
        Gemeinnützig anerkannt — Spendenquittung auf Anfrage.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/foerderverein/#spenden" class="btn-dark">Jetzt spenden</a>
        <a href="/foerderverein/mitglied-werden/" class="btn-ghost">Mitglied werden</a>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
const links = [
  { href: '/schule/unser-team/', title: 'Unser Team', body: 'Schulleitung, Lehrkräfte, ErzieherInnen, Schulsozialarbeit.' },
  { href: '/schule/schulsozialarbeit/', title: 'Schulsozialarbeit', body: 'Beratung, Begleitung, Vermittlung — vertraulich.' },
  { href: '/anmeldung/', title: 'Anmeldung', body: 'Termine und Informationen zur Einschulung.' },
  { href: '/allgemeines/unterrichtszeiten/', title: 'Unterrichtszeiten', body: 'Tagesablauf, OGS-Zeiten, Termine.' }
];
---
<Base title="Unsere Schule">
  <section class="bg-cream-50 pt-16 pb-10">
    <div class="container-c">
      <div class="eyebrow mb-4">Über uns</div>
      <h1 class="text-5xl font-display font-extrabold">Unsere Schule.</h1>
      <p class="mt-4 max-w-2xl leading-relaxed">
        Eine kleine, städtisch katholische Grundschule mit Charakter — mit knapp 220 Kindern,
        zwei Klassen pro Jahrgang und einem Schulgebäude, das Geschichte atmet.
      </p>
    </div>
  </section>
  <section class="bg-cream-100 py-14">
    <div class="container-c grid md:grid-cols-2 gap-6">
      {links.map(l => (
        <a href={l.href} class="card hover:border-gold-500 hover:bg-white transition-colors">
          <div class="font-display font-bold text-2xl">{l.title}</div>
          <p class="mt-2 text-sm text-navy-900/70 leading-relaxed">{l.body}</p>
          <div class="mt-4 text-gold-600 font-semibold text-sm">Mehr erfahren →</div>
        </a>
      ))}
    </div>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
---
<Base title="Schulsozialarbeit">
  <section class="bg-cream-50 pt-16 pb-10">
    <div class="container-c">
      <div class="eyebrow mb-4">Beratung & Unterstützung</div>
      <h1 class="text-5xl font-display font-extrabold">Schulsozialarbeit.</h1>
      <p class="mt-4 max-w-2xl leading-relaxed">
        Vertraulich, niedrigschwellig, kostenfrei. Für Kinder, Eltern und Lehrkräfte.
      </p>
    </div>
  </section>
  <section class="bg-cream-50 pb-16">
    <div class="container-c grid md:grid-cols-2 gap-6">
      <div class="card">
        <div class="eyebrow mb-2">Lysanne Lohstädt</div>
        <p class="text-sm leading-relaxed">Caritas Düsseldorf · Schulsozialarbeit</p>
        <p class="mt-3 text-sm">E-Mail: <a href="mailto:Lysanne.Lohstaedt@caritas-duesseldorf.de" class="text-gold-600">Lysanne.Lohstaedt@caritas-duesseldorf.de</a></p>
        <p class="text-sm">Mobil: 0151 72674975</p>
        <p class="mt-2 text-xs text-navy-900/60">Mo – Fr 8.00 – 16.00 Uhr</p>
      </div>
      <div class="card">
        <div class="eyebrow mb-2">Rania Kassous</div>
        <p class="text-sm leading-relaxed">Schulsozialarbeit</p>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site.ts';
---
<Base title="Kontakt" description="Kontakt zum Förderverein Paul-Klee-Schule Düsseldorf e. V.">

  <section class="bg-cream-50 pt-16 pb-10">
    <div class="container-c max-w-3xl">
      <div class="eyebrow mb-4">Kontakt</div>
      <h1 class="text-4xl md:text-5xl font-display font-bold">Schreiben Sie uns.</h1>
      <p class="mt-6 text-lg leading-relaxed text-navy-900/80">
        Sie haben Fragen zu unserer Arbeit, möchten Mitglied werden, spenden oder sich
        ehrenamtlich einbringen? Wir antworten in der Regel innerhalb weniger Werktage.
      </p>
    </div>
  </section>

  <section class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-12 max-w-3xl">
      <div class="eyebrow mb-3">Förderverein</div>
      <h2 class="text-2xl md:text-3xl font-display font-bold">Förderverein Paul-Klee-Schule Düsseldorf e. V.</h2>

      <div class="mt-8 grid sm:grid-cols-2 gap-3">
        <div class="bg-white p-5 border border-navy-900/10 border-l-4 border-l-pk-yellow">
          <div class="text-xs uppercase tracking-wider text-navy-900/60 font-semibold mb-2">Anschrift</div>
          <div class="text-sm leading-relaxed">
            {SITE.address.street}<br/>
            {SITE.address.zip} {SITE.address.city}
          </div>
        </div>
        <div class="bg-white p-5 border border-navy-900/10 border-l-4 border-l-pk-orange">
          <div class="text-xs uppercase tracking-wider text-navy-900/60 font-semibold mb-2">E-Mail</div>
          <a href={`mailto:${SITE.email}`} class="text-sm hover:text-pk-red break-all">{SITE.email}</a>
        </div>
        <div class="bg-white p-5 border border-navy-900/10 border-l-4 border-l-pk-red">
          <div class="text-xs uppercase tracking-wider text-navy-900/60 font-semibold mb-2">Rechtsstatus</div>
          <div class="text-sm leading-relaxed">
            Gemeinnütziger e. V.<br/>
            Spendenquittungen auf Anfrage
          </div>
        </div>
        <div class="bg-white p-5 border border-navy-900/10 border-l-4 border-l-pk-blue">
          <div class="text-xs uppercase tracking-wider text-navy-900/60 font-semibold mb-2">Vereinsregister</div>
          <div class="text-sm leading-relaxed">
            VR 7008<br/>
            Amtsgericht Düsseldorf
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Hinweis zu Schul-Anliegen */}
  <section class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-12 max-w-3xl">
      <div class="eyebrow mb-3">Für Schul-Anliegen</div>
      <h2 class="text-2xl md:text-3xl font-display font-bold">Fragen rund um die Schule?</h2>
      <p class="mt-6 leading-relaxed text-navy-900/80">
        Für Anmeldung, Krankmeldung, Stundenpläne, Schulsozialarbeit oder andere
        schulbezogene Anliegen wenden Sie sich bitte direkt an die Paul-Klee-Schule.
        Die Schulleitung pflegt alle aktuellen Kontakte und Sprechzeiten auf der
        offiziellen Schulwebsite.
      </p>

      <div class="mt-8 bg-white p-6 border border-navy-900/10">
        <div class="flex items-start gap-5">
          <img
            src={SITE.school.logo}
            alt="Logo der Paul-Klee-Schule"
            class="w-16 h-auto flex-shrink-0"
            width="64"
          />
          <div class="flex-1 min-w-0">
            <div class="text-xs uppercase tracking-wider text-navy-900/60 font-semibold mb-1">Schulwebsite</div>
            <div class="font-display font-semibold">{SITE.school.fullName}</div>
            <div class="text-sm text-navy-900/70 mt-1">
              {SITE.school.address.street}, {SITE.school.address.zip} {SITE.school.address.city}<br/>
              Tel.: {SITE.school.phone}
            </div>
            <a href={SITE.school.website} target="_blank" rel="noopener" class="btn-ghost mt-4">
              grundschule-paul-klee.de
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site.ts';

// Sankt Martin 2026.
//
// Das Programm stammt aus dem Elternbrief der Schule vom Oktober 2026 und
// ist hier inhaltlich unveraendert wiedergegeben. Die Feier findet in der
// Schule und auf dem Schulhof statt — es gibt weder einen Laternenzug durch
// das Viertel noch ein Martinsfeuer. Wer den Text aendert: Quelle ist die
// Schule, nicht der Verein. Erst dort nachfragen.
const FEST = {
  datum: 'Dienstag, 10. November 2026',
  von: '16:30 Uhr',
  bis: 'ca. 18:00 Uhr',
  gedenktag: '11. November'
};

const ABLAUF = [
  {
    zeit: 'ab 16:30 Uhr',
    titel: 'Laternenausstellung in den Klassenräumen',
    text: 'Die Kinder haben schöne Laternen gebastelt und möchten sie gerne zeigen.'
  },
  {
    zeit: 'ab 16:30 Uhr',
    titel: 'Kinderpunsch auf dem Schulhof',
    text: 'Bitte bringen Sie dafür einen eigenen Becher mit.'
  },
  {
    zeit: '17:00 Uhr',
    titel: 'Treffpunkt für alle Kinder',
    text: 'Alle Kinder treffen sich mit den Lehrerinnen und Lehrern in den Klassenräumen. Dann gehen wir gemeinsam mit den Laternen auf den Schulhof und singen dort zusammen Martinslieder. Bitte warten Sie als Eltern in dieser Zeit auf dem Schulhof.'
  },
  {
    zeit: 'gegen 18:00 Uhr',
    titel: 'Ende',
    text: 'Wir freuen uns auf einen schönen Nachmittag mit Ihnen und Ihren Kindern.'
  }
];

// Die Aufsichtsregeln stehen im Elternbrief hervorgehoben. Sie stehen hier
// deshalb in einem eigenen, rot gerahmten Block und nicht in der Liste der
// allgemeinen Hinweise.
const AUFSICHT = [
  'Alle Kinder müssen von der Betreuung abgeholt werden.',
  'Bitte bringen Sie Ihr Kind um 16:30 Uhr mit einer erwachsenen Begleitperson zur Schule.',
  'Kinder dürfen nicht alleine in der Schule bleiben — auch nicht, wenn sie vorher in der Betreuung waren.'
];

const hinweise = [
  'Einen eigenen Becher für den Kinderpunsch mitbringen.',
  'Bitte denken Sie an wetterfeste Kleidung — gesungen wird draußen auf dem Schulhof.',
  'Schultaschen können, wenn nötig, in Raum 005 abgestellt werden.'
];
---
<Base
  title="Sankt Martin an der Paul-Klee-Schule"
  description={`Sankt Martin an der Paul-Klee-Schule Düsseldorf am ${FEST.datum}, ${FEST.von} bis ${FEST.bis}: Laternenausstellung in den Klassenräumen, Martinslieder auf dem Schulhof, Kinderpunsch vom Förderverein.`}
>

  {/* HERO */}
  <section class="bg-cream-50 pt-16 pb-14">
    <div class="container-c grid md:grid-cols-[1.5fr_1fr] gap-12 items-start">
      <div>
        <div class="eyebrow mb-4">Sankt Martin 2026</div>
        <h1 class="text-4xl md:text-5xl font-display font-bold leading-tight">
          Laternen, Lieder und<br/>Punsch auf dem Schulhof.
        </h1>

        <div
          class="mt-7 inline-block bg-white border border-navy-900/10 border-l-4 p-5"
          style="border-left-color:#b13830"
        >
          <div class="text-xs font-semibold uppercase tracking-wider" style="color:#b13830">
            Termin
          </div>
          <div class="mt-1 text-xl md:text-2xl font-display font-bold">
            {FEST.datum}
          </div>
          <div class="mt-0.5 text-lg text-navy-900/80">
            {FEST.von} bis {FEST.bis} · in der Schule
          </div>
        </div>

        <p class="mt-7 text-lg leading-relaxed max-w-2xl text-navy-900/80">
          Die Paul-Klee-Schule feiert Sankt Martin. Alle Kinder, Eltern,
          Geschwister, Großeltern und Freunde der Schule sind herzlich
          eingeladen.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#ablauf" class="btn-dark !py-2.5 !px-4 text-xs">Ablauf</a>
          <a href="#aufsicht" class="btn-ghost !py-2.5 !px-4 text-xs">Aufsicht</a>
          <a href="#foerderverein" class="btn-ghost !py-2.5 !px-4 text-xs">Punsch &amp; Weckmänner</a>
        </div>
      </div>

      {/* Logo der Schule zu Sankt Martin. Traegt den Viaduktbogen des
          Schullogos in der Mitte und liegt in derselben Palette wie die
          Marke — darum ohne Rahmen oder Farbfilter, einfach auf Weiss. */}
      <div class="bg-white p-6 border border-navy-900/10 text-center">
        <picture class="block">
          <source srcset="/img/sankt-martin-logo.webp" type="image/webp" />
          <img
            src="/img/sankt-martin-logo.jpg"
            alt="Sankt Martin zu Pferd teilt seinen Mantel mit einem Bettler, dahinter der Viaduktbogen der Paul-Klee-Schule und Kinder mit Laternen"
            class="w-full h-auto"
            width="760"
            height="976"
            loading="eager"
          />
        </picture>
        <div class="mt-5 text-xs uppercase tracking-wider text-navy-900/60">
          Laternenausstellung · Martinslieder · Punsch
        </div>
        <div class="mt-1 font-display font-semibold text-navy-900">
          In der Paul-Klee-Schule
        </div>
      </div>
    </div>
  </section>

  {/* ABLAUF */}
  <section class="bg-cream-50" id="ablauf">
    <div class="container-c border-t border-navy-900/10 py-14">
      <div class="max-w-3xl">
        <div class="eyebrow mb-3">Das Programm der Schule</div>
        <h2 class="text-2xl md:text-3xl font-display font-bold">Ablauf</h2>

        <ol class="mt-8 divide-y divide-navy-900/10 border-y border-navy-900/10">
          {ABLAUF.map((punkt) => (
            <li class="py-5 grid sm:grid-cols-[10rem_1fr] gap-1 sm:gap-6">
              <div class="text-xs uppercase tracking-wider font-semibold sm:pt-1" style="color:#b13830">
                {punkt.zeit}
              </div>
              <div>
                <div class="font-display font-bold">{punkt.titel}</div>
                <p class="mt-1 leading-relaxed text-navy-900/80">{punkt.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {/* AUFSICHT */}
  <section class="bg-cream-50" id="aufsicht">
    <div class="container-c border-t border-navy-900/10 py-14">
      <div class="max-w-3xl">
        <div class="bg-white border-2 p-8 md:p-10" style="border-color:#b13830">
          <div class="text-xs font-semibold uppercase tracking-wider" style="color:#b13830">
            Wichtig
          </div>
          <h2 class="mt-3 text-2xl md:text-3xl font-display font-bold">
            Die Aufsichtspflicht liegt bei den Eltern
          </h2>
          <ul class="mt-6 space-y-4">
            {AUFSICHT.map((a) => (
              <li class="flex gap-4 items-start">
                <span class="mt-2.5 w-2 h-2 shrink-0" style="background-color:#b13830"></span>
                <span class="text-lg leading-relaxed text-navy-900/80">{a}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* WARUM */}
  <section class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-14">
      <div class="max-w-3xl">
        <div class="eyebrow mb-3">Hintergrund</div>
        <h2 class="text-2xl md:text-3xl font-display font-bold">
          Warum wir Sankt Martin feiern
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-navy-900/80">
          Martin von Tours lebte im 4. Jahrhundert und war zunächst Soldat im
          römischen Heer. Der Legende nach begegnete er an einem kalten
          Winterabend vor den Toren von Amiens einem frierenden Bettler.
          Kurzerhand teilte er seinen Mantel mit dem Schwert und schenkte ihm
          eine Hälfte.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-navy-900/80">
          Später wurde Martin Mönch und schließlich Bischof von Tours.
          Beigesetzt wurde er am {FEST.gedenktag} 397 — seitdem ist dieser Tag
          sein Gedenktag.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-navy-900/80">
          Mit den Laternen, den Liedern und dem, was wir an diesem Nachmittag
          miteinander teilen, erinnern wir an seine Botschaft: Licht in die
          Dunkelheit bringen und füreinander da sein.
        </p>
      </div>
    </div>
  </section>

  {/* FOERDERVEREIN */}
  <section class="bg-cream-50" id="foerderverein">
    <div class="container-c border-t border-navy-900/10 py-14">
      <div class="max-w-3xl">
        <div class="eyebrow mb-3">Unser Beitrag</div>
        <h2 class="text-2xl md:text-3xl font-display font-bold">
          Der Förderverein ist dabei
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-navy-900/80">
          Wie in jedem Jahr unterstützt der Förderverein die Feier. Wir sorgen
          für Weckmänner für alle Kinder, Kinderpunsch und Kaffee.
        </p>

        <div class="mt-8 grid sm:grid-cols-3 gap-3">
          <div class="bg-white p-5 border border-navy-900/10 border-l-4 border-l-pk-yellow">
            <div class="font-display font-semibold">Weckmänner</div>
            <div class="mt-1 text-sm text-navy-900/70">Für alle Kinder der Schule.</div>
          </div>
          <div class="bg-white p-5 border border-navy-900/10 border-l-4 border-l-pk-orange">
            <div class="font-display font-semibold">Kinderpunsch</div>
            <div class="mt-1 text-sm text-navy-900/70">
              Auf dem Schulhof, ab 16:30 Uhr. Bitte eigenen Becher mitbringen.
            </div>
          </div>
          <div class="bg-white p-5 border border-navy-900/10 border-l-4 border-l-pk-red">
            <div class="font-display font-semibold">Kaffee</div>
            <div class="mt-1 text-sm text-navy-900/70">Für die Erwachsenen.</div>
          </div>
        </div>

        <p class="mt-8 text-lg leading-relaxed text-navy-900/80">
          Der Erlös aus dem Verkauf kommt vollständig den Kindern der
          Paul-Klee-Schule zugute und fließt in konkrete Projekte des
          Fördervereins.
        </p>
        <a href="/foerderverein/#projekte" class="mt-6 inline-flex btn-ghost !py-2.5 !px-4 text-xs">
          Was wir damit finanzieren
        </a>
      </div>
    </div>
  </section>

  {/* HELFER */}
  <section class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-14">
      <div class="max-w-3xl">
        <div class="bg-white border border-navy-900/10 border-l-4 p-8 md:p-10" style="border-left-color:#e0a836">
          <div class="text-xs font-semibold uppercase tracking-wider" style="color:#c89010">
            Eine Stunde Zeit?
          </div>
          <h2 class="mt-3 text-2xl md:text-3xl font-display font-bold">
            Wir freuen uns über Unterstützung
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-navy-900/80">
            Damit der Nachmittag gelingt, brauchen wir Hände beim Aufbau, am
            Stand auf dem Schulhof und beim Abbau. Wer eine Stunde Zeit hat,
            meldet sich gern über unser Kontaktformular.
          </p>
          <a href="/kontakt/" class="mt-7 inline-flex btn-dark">Ich helfe mit</a>
        </div>
      </div>
    </div>
  </section>

  {/* HINWEISE */}
  <section class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-14">
      <div class="max-w-3xl">
        <div class="eyebrow mb-3">Praktisches</div>
        <h2 class="text-2xl md:text-3xl font-display font-bold">Hinweise für Eltern</h2>
        <ul class="mt-7 space-y-4">
          {hinweise.map((h) => (
            <li class="flex gap-4 items-start">
              <span class="mt-2.5 w-2 h-2 shrink-0 bg-pk-red"></span>
              <span class="text-lg leading-relaxed text-navy-900/80">{h}</span>
            </li>
          ))}
        </ul>

        <p class="mt-10 text-lg leading-relaxed text-navy-900/80">
          Sankt Martin steht für Teilen und Zusammenhalt. Genau das wollen wir
          an diesem Nachmittag gemeinsam erleben. Wir freuen uns auf Sie und
          Ihre Kinder.
        </p>
        <p class="mt-6 font-display font-semibold">
          Ihr Vorstand des {SITE.nameGenitiv}
        </p>
      </div>
    </div>
  </section>

</Base>

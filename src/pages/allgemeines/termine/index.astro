---
import Base from '../../../layouts/Base.astro';
---
<Base title="Termine">
  <section class="bg-cream-50 pt-16 pb-10">
    <div class="container-c">
      <div class="eyebrow mb-4">Schuljahr</div>
      <h1 class="text-5xl font-display font-extrabold">Termine.</h1>
      <p class="mt-4 max-w-2xl text-navy-900/70">
        Aktuelle Schul-, Ferien- und Veranstaltungstermine. Eine vollständige Übersicht erhalten Sie über das Sekretariat.
      </p>
    </div>
  </section>
</Base>

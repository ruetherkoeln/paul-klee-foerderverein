---
import Base from '../../layouts/Base.astro';
---
<Base title="Allgemeines">
  <section class="bg-cream-50 pt-16 pb-10">
    <div class="container-c">
      <div class="eyebrow mb-4">Information</div>
      <h1 class="text-5xl font-display font-extrabold">Allgemeines.</h1>
      <p class="mt-4 max-w-2xl">Termine, Unterrichtszeiten, organisatorische Hinweise.</p>
    </div>
  </section>
  <section class="bg-cream-50 pb-16">
    <div class="container-c grid md:grid-cols-2 gap-6">
      <a href="/allgemeines/unterrichtszeiten/" class="card hover:border-gold-500">
        <div class="font-display font-bold text-2xl">Unterrichtszeiten</div>
        <p class="mt-2 text-sm text-navy-900/70">Stunden- und OGS-Plan im Überblick.</p>
        <div class="mt-4 text-gold-600 font-semibold text-sm">Mehr erfahren →</div>
      </a>
      <a href="/allgemeines/termine/" class="card hover:border-gold-500">
        <div class="font-display font-bold text-2xl">Termine</div>
        <p class="mt-2 text-sm text-navy-900/70">Schulhalbjahr, Ferien, Konferenzen, Feste.</p>
        <div class="mt-4 text-gold-600 font-semibold text-sm">Mehr erfahren →</div>
      </a>
    </div>
  </section>
</Base>

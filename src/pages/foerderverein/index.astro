---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site.ts';
import { STEUER } from '../../data/verein-steuer.ts';
import QRCode from 'qrcode';

// EPC QR Code (GiroCode) — deutsche Banking-Apps scannen den Code
// und füllen den Überweisungs-Dialog automatisch aus.
const epcData = [
  'BCD',                                              // Service Tag
  '002',                                              // Version
  '1',                                                // Encoding (UTF-8)
  'SCT',                                              // SEPA Credit Transfer
  'DUSSDEDDXXX',                                      // BIC (Stadtsparkasse Düsseldorf)
  'Förderverein der Paul-Klee-Schule',                // Zahlungsempfänger
  'DE81300501100037036266',                           // IBAN (ohne Leerzeichen)
  '',                                                 // Betrag (leer = im Banking eingeben)
  'CHAR',                                             // Verwendungsschlüssel: Charity
  '',                                                 // Strukturierte Referenz
  'Spende',                                           // Verwendungszweck
  ''                                                  // Zusatzinfo
].join('\n');

const spendenQr = await QRCode.toString(epcData, {
  type: 'svg',
  errorCorrectionLevel: 'M',
  margin: 1,
  width: 180
});

// PayPal-Spende — Managed-QR-Link des Vereinskontos.
// Scannbar (Handykamera / PayPal-App) und im Browser anklickbar.
const paypalUrl = 'https://www.paypal.com/qrcodes/managed/df0fcaad-efe2-41b3-9f80-59c2423d8459?utm_source=payandgetpaid';
const paypalQr = await QRCode.toString(paypalUrl, {
  type: 'svg',
  errorCorrectionLevel: 'M',
  margin: 1,
  width: 180
});

const kennzahlen = [
  { value: '~220', label: 'Kinder an der Schule' },
  { value: '30+', label: 'Herkunftsländer der Familien' },
  { value: '100 %', label: 'Mittel direkt an die Kinder' }
];

const brennpunkt = [
  { color: 'border-l-pk-yellow', kicker: '> 30', title: 'Herkunftsländer', body: 'unter den Schülerfamilien — sprachliche und kulturelle Vielfalt als Alltag. Für Kinder und Lehrer: eine besondere Herausforderung.' },
  { color: 'border-l-pk-red',    kicker: 'Tägliches Engagement', title: 'Bedarf und Grundbedürfnisse', body: 'Kinder ohne Frühstück, ohne Schulmaterial, teils ohne Unterstützung daheim.' },
  { color: 'border-l-pk-blue',   kicker: 'Lücke überbrücken', title: 'Pädagogisches Konzept gestalten', body: 'Ausflüge, Musikunterricht, Sportgeräte, digitale Ausstattung — nicht im Regelbudget NRW vorgesehen.' }
];

// Logo-Farben werden über die Sektionen verteilt (Yellow → Orange → Red → Blue → Green)
const werte = [
  { color: 'border-l-pk-yellow', title: 'Gemeinnützig und transparent', body: 'Eingetragener Verein, steuerlich anerkannt — Spendenquittungen auf Anfrage.' },
  { color: 'border-l-pk-orange', title: '100 % direkt für die Projekte', body: 'Keine Verwaltungskosten — jeder Euro kommt bei den Schülerinnen und Schülern an.' },
  { color: 'border-l-pk-red',    title: 'Ehrenamtlich geführt', body: 'Alle Vorstandsmitglieder arbeiten ohne Vergütung.' },
  { color: 'border-l-pk-blue',   title: 'Mitgliedschaft offen für alle', body: 'Ab 12 € im Jahr — Mitsprache in der Mitgliederversammlung.' }
];

const projekte = [
  { num: '01', color: 'border-t-pk-yellow', title: 'Lernmittel & Ausstattung', body: 'Schulhefte, Stifte, Taschenrechner — für Kinder, deren Familien sich das Nötigste nicht leisten können.' },
  { num: '02', color: 'border-t-pk-orange', title: 'Klassenfahrten & Ausflüge', body: 'Bezuschussung von Klassenfahrten und Ausflügen für Familien ohne die nötigen Mittel.' },
  { num: '03', color: 'border-t-pk-red',    title: 'Musik, Kunst & Sport', body: 'Instrumente, Sporttrikots, Theaterworkshops — Angebote jenseits des Regelbudgets.' },
  { num: '04', color: 'border-t-pk-blue',   title: 'Digitale Teilhabe', body: 'Tablets, Lernsoftware, Druckerpatronen, WLAN-Hotspots — damit kein Kind beim digitalen Lernen abgehängt wird.' },
  { num: '05', color: 'border-t-pk-green',  title: 'Frühstück & Grundversorgung', body: 'Kofinanzierung von Frühstücksangeboten und Grundversorgung im Schulalltag.' },
  { num: '06', color: 'border-t-pk-ink',    title: 'Schulverschönerung', body: 'Beiträge zur Gestaltung von Räumen, Pausenhof und Garten — eine Umgebung, in der Kinder gern lernen.' }
];

const zukunft = [
  { color: 'border-l-pk-blue',   title: 'Mentoring-Programm', body: 'Ehrenamtliche begleiten Schülerinnen und Schüler über mehrere Jahre — individuell, verlässlich, nachhaltig.' },
  { color: 'border-l-pk-green',  title: 'Bibliothek & Leseförderung', body: 'Aufbau einer Schulbibliothek mit mehrsprachigen Beständen.' },
  { color: 'border-l-pk-orange', title: 'Schüler-Werkstatt', body: 'Ein Raum zum Bauen, Reparieren, Gestalten — praktische Fähigkeiten und Selbstwirksamkeit.' },
  { color: 'border-l-pk-yellow', title: 'Klassenmöblierung', body: 'Umgestaltung der Klassenräume — Sitzanordnung in halbkreisförmiger Ausführung nach neusten pädagogischen Erkenntnissen.' }
];

const spendenStufen = [10, 25, 50, 100];
---
<Base title="Der Verein" description={SITE.description}>

  {/* HERO */}
  <section class="bg-cream-50 pt-16 pb-14">
    <div class="container-c grid md:grid-cols-[1.5fr_1fr] gap-12 items-start">
      <div>
        <div class="eyebrow mb-4">Förderverein · gemeinnützig · seit 2025</div>
        <h1 class="text-4xl md:text-5xl font-display font-bold leading-tight">
          Der Verein.
        </h1>
        <p class="mt-6 text-lg leading-relaxed max-w-2xl text-navy-900/80">
          Wir sind der Förderverein der Paul-Klee-Schule — Gerresheimer Straße, Düsseldorf.
          Unsere Arbeit zielt darauf, die Lücke zwischen dem, was Kinder brauchen, und dem,
          was das Regelbudget bereitstellt, zu schließen.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#spenden" class="btn-dark">Jetzt spenden</a>
          <a href="/spenden/bescheinigung/" class="btn-ghost">Bescheinigung anfordern</a>
          <a href="#projekte" class="btn-ghost">Unsere Projekte</a>
        </div>
      </div>
      <div class="space-y-8 md:pl-10 md:border-l md:border-navy-900/10">
        {kennzahlen.map(k => (
          <div>
            <div class="text-4xl md:text-5xl font-display font-bold text-navy-900 leading-none">{k.value}</div>
            <div class="text-navy-900/60 mt-2 max-w-xs text-sm">{k.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ÜBER UNS */}
  <section id="ueber-uns" class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-16 grid md:grid-cols-2 gap-12">
      <div>
        <div class="eyebrow mb-3">Wer wir sind</div>
        <h2 class="text-3xl md:text-4xl font-display font-bold">Ein Verein, eine Mission, eine Schule.</h2>
        <p class="mt-6 leading-relaxed text-navy-900/80">
          Gegründet von Eltern, Lehrkräften und Engagierten, die erkannt haben: Zwischen dem,
          was Kinder brauchen, und dem, was das Land bereitstellt, klafft eine Lücke.
        </p>
        <p class="mt-4 leading-relaxed text-navy-900/80">
          Der Förderverein der Paul-Klee-Schule e. V. ist ein gemeinnütziger Verein, der
          ausschließlich zur Unterstützung des Schullebens, der pädagogischen Arbeit und
          der sozialen Teilhabe tätig ist.
        </p>
        <p class="mt-4 leading-relaxed text-navy-900/80">
          Jeder gespendete Euro verbleibt zu 100 % an der Schule — keine Verwaltungsebene
          dazwischen.
        </p>
      </div>
      <div class="space-y-3">
        {werte.map(w => (
          <div class={`bg-white p-5 border border-navy-900/10 border-l-4 ${w.color}`}>
            <div class="font-semibold text-base">{w.title}</div>
            <p class="text-sm text-navy-900/70 mt-2 leading-relaxed">{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* BRENNPUNKT */}
  <section id="brennpunkt" class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-16 grid md:grid-cols-2 gap-12">
      <div>
        <div class="eyebrow mb-3">Hintergrund</div>
        <h2 class="text-3xl md:text-4xl font-display font-bold">Was bedeutet „Brennpunktschule".</h2>
        <p class="mt-6 leading-relaxed text-navy-900/80">
          Der Begriff bezeichnet Schulen in sozial benachteiligten Stadtteilen, an denen ein
          überdurchschnittlich hoher Anteil der Schülerinnen und Schüler aus einkommensschwachen
          Familien stammt, mehrsprachig aufwächst oder besondere Förderbedarfe mitbringt.
        </p>
        <p class="mt-4 leading-relaxed text-navy-900/80">
          Das bedeutet konkret: ein höherer Bedarf an Unterstützung — bei einem Landesbudget,
          das diese Realität nicht vollständig abdeckt. Genau dort setzt unsere Arbeit an.
        </p>
      </div>
      <div class="space-y-3">
        {brennpunkt.map(b => (
          <div class={`bg-white p-5 border border-navy-900/10 border-l-4 ${b.color}`}>
            <div class="text-2xl font-display font-bold text-navy-900">{b.kicker}</div>
            <div class="mt-1 font-semibold">{b.title}</div>
            <p class="text-navy-900/70 mt-2 text-sm leading-relaxed">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* PROJEKTE */}
  <section id="projekte" class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-16">
      <div class="eyebrow mb-3">Was wir tun</div>
      <h2 class="text-3xl md:text-4xl font-display font-bold">Konkrete Förderbereiche.</h2>
      <p class="mt-6 max-w-2xl leading-relaxed text-navy-900/80">
        Was das Land NRW nicht finanziert, finanzieren wir — mit der Unterstützung von
        Mitgliedern und Spendern. Diese Projekte existieren nur dank der Beiträge.
      </p>
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {projekte.map(p => (
          <div class={`bg-white p-6 border border-navy-900/10 border-t-4 ${p.color}`}>
            <div class="text-xs text-navy-900/50 font-semibold tracking-wider">{p.num}</div>
            <h3 class="mt-2 text-lg font-display font-semibold">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-navy-900/75">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ZUKUNFT */}
  <section id="zukunft" class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-16 grid md:grid-cols-2 gap-12">
      <div>
        <div class="eyebrow mb-3">Zukunft</div>
        <h2 class="text-3xl md:text-4xl font-display font-bold">Was wir aufbauen wollen.</h2>
        <p class="mt-6 leading-relaxed text-navy-900/80">
          Einzelne Projekte sind wichtig — verlässliche Strukturen sind langfristig wirkungsvoller.
          Dies sind unsere mittel- und langfristigen Ziele.
        </p>
      </div>
      <div class="space-y-3">
        {zukunft.map(z => (
          <div class={`bg-white p-5 border border-navy-900/10 border-l-4 ${z.color}`}>
            <div class="font-semibold">{z.title}</div>
            <p class="text-navy-900/70 text-sm mt-2 leading-relaxed">{z.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* SPENDEN */}
  <section id="spenden" class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-16">
      <div class="eyebrow mb-3">Unterstützen</div>
      <h2 class="text-3xl md:text-4xl font-display font-bold">Spenden.</h2>
      <p class="mt-6 max-w-2xl leading-relaxed text-navy-900/80">
        10 € decken Hefte und Stifte für einen Monat. 25 € ermöglichen einen Ausflug.
        50 € finanzieren eine Woche Frühstück für fünf Kinder. 100 € einen Sportgeräte-Satz.
      </p>

      <div class="mt-8 max-w-2xl">
        <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
          {spendenStufen.map(s => (
            <a href={paypalUrl} target="_blank" rel="noopener" class="px-4 py-4 border-2 border-navy-900/15 hover:border-gold-500 hover:bg-white font-display font-semibold text-lg bg-white transition-colors text-center">
              {s} €
            </a>
          ))}
          <a href={paypalUrl} target="_blank" rel="noopener" class="px-4 py-4 border-2 border-navy-900/15 hover:border-gold-500 hover:bg-white font-display font-semibold text-lg bg-white transition-colors text-center">
            Frei
          </a>
        </div>
        <p class="mt-3 text-xs text-navy-900/60">
          Direkt-Spende per PayPal — den genauen Betrag wählen Sie anschließend in PayPal.
          Lieber per Überweisung? Bankverbindung und GiroCode finden Sie unten.
        </p>
      </div>

      {/* BANKVERBINDUNG (primär) */}
      <div class="mt-10 max-w-2xl bg-white p-6 md:p-8 border border-navy-900/10 border-l-4 border-l-pk-yellow">
        <div class="eyebrow mb-2">Bankverbindung</div>
        <h3 class="text-xl font-display font-semibold">Spende per Überweisung.</h3>
        <p class="mt-3 text-sm leading-relaxed text-navy-900/75">
          Ihre Spende geht direkt an den Förderverein der Paul-Klee-Schule Düsseldorf e. V. —
          gemeinnützig anerkannt. Spendenquittung auf Anfrage per E-Mail.
        </p>

        <div class="mt-6 grid md:grid-cols-[1fr_180px] gap-6 md:gap-8 items-start">
        <dl class="space-y-4 text-sm">
          <div class="grid grid-cols-[100px_1fr] gap-3 items-start">
            <dt class="text-navy-900/60 font-semibold">Kontoinhaber</dt>
            <dd>Förderverein der Paul-Klee-Schule</dd>
          </div>
          <div class="grid grid-cols-[100px_1fr] gap-3 items-start">
            <dt class="text-navy-900/60 font-semibold">IBAN</dt>
            <dd class="flex items-center gap-2 flex-wrap">
              <code class="font-mono text-base bg-cream-100 px-2 py-1 select-all">DE81 3005 0110 0037 0362 66</code>
              <button
                type="button"
                class="copy-btn text-xs px-3 py-1 border border-navy-900/15 hover:border-pk-yellow hover:bg-cream-100 transition-colors uppercase tracking-wider font-semibold"
                data-copy="DE81300501100037036266"
                aria-label="IBAN in die Zwischenablage kopieren"
              >Kopieren</button>
            </dd>
          </div>
          <div class="grid grid-cols-[100px_1fr] gap-3 items-start">
            <dt class="text-navy-900/60 font-semibold">BIC</dt>
            <dd class="flex items-center gap-2 flex-wrap">
              <code class="font-mono text-base bg-cream-100 px-2 py-1 select-all">DUSSDEDDXXX</code>
              <span class="text-xs text-navy-900/50">Stadtsparkasse Düsseldorf</span>
            </dd>
          </div>
          <div class="grid grid-cols-[100px_1fr] gap-3 items-start">
            <dt class="text-navy-900/60 font-semibold">Verwendungs-<br/>zweck</dt>
            <dd>
              <code class="font-mono text-sm bg-cream-100 px-2 py-1">Spende</code>
              <span class="text-xs text-navy-900/60 ml-2">— oder Anlass z. B. „Klassenfahrt 3a"</span>
            </dd>
          </div>
        </dl>

        {/* EPC GiroCode — scannen statt tippen */}
        <div class="flex flex-col items-center gap-3">
          <div class="bg-white p-2 border border-navy-900/10" set:html={spendenQr} />
          <p class="text-xs text-navy-900/60 text-center max-w-[180px] leading-snug">
            Mit der Banking-App scannen — Überweisungs-Dialog füllt sich aus.
          </p>
        </div>
        </div>

        {STEUER.AUSSTELLUNG_AKTIV ? (
          <p class="mt-6 text-sm text-navy-900/75">
            <a href="/spenden/bescheinigung/" class="text-pk-red font-semibold hover:underline">Zuwendungsbescheinigung online anfordern →</a>
            <br />
            <span class="text-xs text-navy-900/60">Alternativ per E-Mail an {SITE.email} mit Datum und Höhe der Spende.</span>
          </p>
        ) : (
          <p class="mt-6 text-xs text-navy-900/60">
            Für eine Spendenquittung bitte E-Mail an
            <a href={`mailto:${SITE.email}?subject=Spendenquittung`} class="text-pk-red hover:underline">{SITE.email}</a>
            mit Datum und Höhe der Spende.
          </p>
        )}
      </div>

      {/* PAYPAL (online, sofort) */}
      <div id="paypal" class="mt-6 max-w-2xl bg-white p-6 md:p-8 border border-navy-900/10 border-l-4 border-l-pk-blue">
        <div class="eyebrow mb-2">Online spenden</div>
        <h3 class="text-xl font-display font-semibold">Spende per PayPal.</h3>
        <p class="mt-3 text-sm leading-relaxed text-navy-900/75">
          Schnell und ohne Kontodaten — mit PayPal oder Kredit- bzw. Girokarte.
          Am Smartphone den Code scannen, am Rechner einfach auf den Button tippen.
        </p>

        <div class="mt-6 grid sm:grid-cols-[180px_1fr] gap-6 sm:gap-8 items-center">
          {/* QR zum Scannen */}
          <a href={paypalUrl} target="_blank" rel="noopener" class="block bg-white p-2 border border-navy-900/10 w-[180px] mx-auto sm:mx-0" aria-label="PayPal-Spendenseite öffnen" set:html={paypalQr} />

          <div>
            <a href={paypalUrl} target="_blank" rel="noopener" class="btn-dark">
              Mit PayPal spenden
            </a>
            <p class="mt-3 text-xs text-navy-900/60 leading-snug">
              Den Spendenbetrag legen Sie auf der PayPal-Seite fest.
              Spendenquittung auf Anfrage per E-Mail.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-10 max-w-2xl">
        <div class="eyebrow mb-2">Alternative</div>
        <h3 class="text-xl font-display font-semibold">Mitglied werden — schon ab 12 € im Jahr.</h3>
        <p class="mt-3 text-sm leading-relaxed text-navy-900/75">
          Mit einer Mitgliedschaft unterstützen Sie verlässlich und langfristig — und stimmen
          in der Mitgliederversammlung darüber ab, welche Projekte gefördert werden.
        </p>
        <a href="/foerderverein/mitglied-werden/" class="btn-ghost mt-5">Mitgliedsantrag</a>
      </div>
    </div>
  </section>

  {/* KONTAKT */}
  <section id="kontakt" class="bg-cream-50">
    <div class="container-c border-t border-navy-900/10 py-16 grid md:grid-cols-2 gap-12">
      <div>
        <div class="eyebrow mb-3">Kontakt</div>
        <h2 class="text-3xl md:text-4xl font-display font-bold">Schreiben Sie uns.</h2>
        <p class="mt-6 leading-relaxed text-navy-900/80">
          Ob als Mitglied, Förderer oder mit einer Idee zur Mitarbeit — wir freuen uns
          auf Ihre Nachricht.
        </p>
        <div class="mt-8 space-y-3">
          <div class="bg-white p-5 border border-navy-900/10">
            <div class="text-xs uppercase tracking-wider text-gold-600 font-semibold mb-1">Adresse</div>
            <div class="text-sm">{SITE.address.street}, {SITE.address.zip} {SITE.address.city}</div>
          </div>
          <div class="bg-white p-5 border border-navy-900/10">
            <div class="text-xs uppercase tracking-wider text-gold-600 font-semibold mb-1">E-Mail</div>
            <a href={`mailto:${SITE.email}`} class="text-sm hover:text-gold-600">{SITE.email}</a>
          </div>
          <div class="bg-white p-5 border border-navy-900/10">
            <div class="text-xs uppercase tracking-wider text-gold-600 font-semibold mb-1">Rechtsstatus</div>
            <div class="text-sm">Gemeinnütziger e. V. · Spendenquittungen möglich</div>
          </div>
        </div>
      </div>
      <form class="bg-white p-6 border border-navy-900/10 space-y-4" method="post" action="https://api.web3forms.com/submit">
        {/* Web3Forms Setup */}
        <input type="hidden" name="access_key" value="f634ff3d-5084-45f6-84d2-e6796b6924c5" />
        <input type="hidden" name="subject" value="Neue Kontaktanfrage – Förderverein Paul-Klee-Schule" />
        <input type="hidden" name="from_name" value="Förderverein Paul-Klee-Schule – Kontakt" />
        <input type="hidden" name="redirect" value="https://paul-klee-foerderverein.vercel.app/danke/?type=kontakt" />
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

        <div>
          <label for="kontakt-name" class="text-sm font-semibold">Ihr Name</label>
          <input id="kontakt-name" required type="text" name="name" class="mt-1 w-full px-4 py-3 border border-navy-900/15 focus:border-gold-500 outline-none" />
        </div>
        <div>
          <label for="kontakt-email" class="text-sm font-semibold">Ihre E-Mail-Adresse</label>
          <input id="kontakt-email" required type="email" name="email" class="mt-1 w-full px-4 py-3 border border-navy-900/15 focus:border-gold-500 outline-none" />
        </div>
        <div>
          <label for="kontakt-message" class="text-sm font-semibold">Ihre Nachricht</label>
          <textarea id="kontakt-message" required name="message" rows="5" placeholder="Idee, Frage, Angebot zur Mitarbeit …" class="mt-1 w-full px-4 py-3 border border-navy-900/15 focus:border-gold-500 outline-none"></textarea>
        </div>
        <button class="btn-dark w-full justify-center">Nachricht senden</button>
        <p class="text-xs text-navy-900/60">
          Mit dem Absenden stimmen Sie der Verarbeitung Ihrer Daten gemäß unserer
          <a href="/datenschutz/" class="underline">Datenschutzerklärung</a> zu.
        </p>
      </form>
    </div>
  </section>
</Base>

<script>
  // Copy-Buttons (IBAN etc.) — universal "click to clipboard"
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy;
      if (!value) return;
      const original = btn.textContent ?? 'Kopieren';
      try {
        await navigator.clipboard.writeText(value);
        btn.textContent = 'Kopiert ✓';
      } catch {
        // Fallback: selektieren
        btn.textContent = 'Bitte manuell kopieren';
      }
      setTimeout(() => {
        btn.textContent = original;
      }, 2000);
    });
  });
</script>

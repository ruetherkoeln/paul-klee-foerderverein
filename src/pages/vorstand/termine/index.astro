---
// Vorstandsbereich — Termine: Sitzungen, Fristen, Veranstaltungen.
import Base from '../../../layouts/Base.astro';
import VorstandNav from '../../../components/VorstandNav.astro';
import { VORSTAND, START, KONTAKT, terminDatum } from '../../../lib/vorstand.ts';
import { geschuetzt } from '../../../lib/zugang.ts';
import { kommendeTermine, vergangeneTermine } from '../../../lib/vorstand-db.ts';
import type { Termin } from '../../../lib/vorstand-db.ts';

export const prerender = false;

geschuetzt(Astro.response.headers);
if (!VORSTAND.angemeldet(Astro.cookies)) return Astro.redirect(START, 303);

const HINWEISE: Record<string, { text: string; gut?: boolean }> = {
  angelegt: { text: 'Der Termin ist eingetragen.', gut: true },
  geloescht: { text: 'Der Termin ist gelöscht.', gut: true },
  'nicht-bestaetigt': { text: 'Zum Löschen bitte zuerst das Häkchen „Ja, löschen“ setzen.' },
  angaben: { text: 'Bitte mindestens Datum und Titel angeben.' },
  technik: { text: `Das hat technisch nicht geklappt. Bitte später noch einmal versuchen oder an ${KONTAKT} schreiben.` },
};
const hinweis = HINWEISE[Astro.url.searchParams.get('hinweis') ?? ''];

let kommend: Termin[] = [];
let vergangen: Termin[] = [];
let datenFehler = false;
try {
  [kommend, vergangen] = await Promise.all([kommendeTermine(), vergangeneTermine(10)]);
} catch (e) {
  console.error('Vorstand: Termine nicht ladbar —', (e as Error).message);
  datenFehler = true;
}

const feld = 'w-full border border-navy-900/20 px-4 py-3 bg-white focus:outline-none focus:border-navy-900';
const label = 'block text-xs font-semibold uppercase tracking-wider text-navy-900/70 mb-1';
---
<Base title="Termine · Vorstand" robots="noindex, nofollow" description="Interner Bereich des Vorstands.">
  <section class="bg-cream-50 pt-16 pb-16">
    <div class="container-c max-w-4xl">
      <div class="eyebrow mb-4">Nur für den Vorstand</div>
      <h1 class="text-3xl md:text-4xl font-display font-bold">Termine</h1>
      <VorstandNav aktiv="termine" />

      {hinweis && (
        <div role="status" class={`mt-8 bg-white border border-navy-900/10 border-l-4 p-5 ${hinweis.gut ? 'border-l-pk-yellow' : 'border-l-pk-red'}`}>
          <p class="text-sm leading-relaxed">{hinweis.text}</p>
        </div>
      )}
      {datenFehler && (
        <div role="alert" class="mt-8 bg-white border-2 border-pk-red p-5 text-sm">
          Die Termine konnten gerade nicht geladen werden. Bitte die Seite in einer Minute neu laden.
        </div>
      )}

      <h2 class="mt-12 text-2xl font-display font-bold">Kommende Termine</h2>
      {!datenFehler && kommend.length === 0 && <p class="mt-4 text-sm text-navy-900/70">Keine Termine eingetragen.</p>}
      <ul class="mt-6 space-y-3">
        {kommend.map((t) => (
          <li class="bg-white p-5 border border-navy-900/10 border-l-4 border-l-pk-yellow flex flex-wrap gap-4 items-start">
            <div class="flex-1 min-w-[14rem]">
              <div class="text-sm font-semibold text-gold-600">
                {terminDatum(t.datum)}{t.uhrzeit && `, ${t.uhrzeit} Uhr`}
              </div>
              <div class="mt-1 text-lg font-semibold">{t.titel}</div>
              {t.ort && <div class="mt-1 text-sm text-navy-900/70">{t.ort}</div>}
              {t.notiz && <p class="mt-2 text-sm leading-relaxed text-navy-900/80 whitespace-pre-line">{t.notiz}</p>}
            </div>
            <form method="POST" action="/vorstand/termine/aktion" class="flex items-center gap-3 text-sm">
              <input type="hidden" name="aktion" value="loeschen" />
              <input type="hidden" name="id" value={t.id} />
              <label class="flex items-center gap-1 text-navy-900/70">
                <input type="checkbox" name="sicher" value="ja" /> Ja, löschen
              </label>
              <button type="submit" class="underline text-navy-900/60 hover:text-navy-900">Löschen</button>
            </form>
          </li>
        ))}
      </ul>

      <form method="POST" action="/vorstand/termine/aktion" class="mt-10 bg-white p-6 border border-navy-900/10 space-y-4">
        <h3 class="font-semibold">Termin eintragen</h3>
        <div class="grid sm:grid-cols-3 gap-3">
          <div>
            <label for="datum" class={label}>Datum *</label>
            <input id="datum" name="datum" type="date" required class={feld} />
          </div>
          <div>
            <label for="uhrzeit" class={label}>Uhrzeit</label>
            <input id="uhrzeit" name="uhrzeit" type="time" class={feld} />
          </div>
          <div>
            <label for="ort" class={label}>Ort</label>
            <input id="ort" name="ort" maxlength="160" class={feld} placeholder="z. B. Schule, Raum 12" />
          </div>
        </div>
        <div>
          <label for="titel" class={label}>Titel *</label>
          <input id="titel" name="titel" required maxlength="160" class={feld} placeholder="z. B. Vorstandssitzung" />
        </div>
        <div>
          <label for="notiz" class={label}>Notiz</label>
          <textarea id="notiz" name="notiz" rows="3" maxlength="2000" class={feld} placeholder="Tagesordnung, Hinweise …"></textarea>
        </div>
        <button type="submit" class="btn-dark">Eintragen</button>
      </form>

      {vergangen.length > 0 && (
        <div class="mt-14">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-navy-900/60">Vergangene Termine</h2>
          <ul class="mt-3 space-y-2">
            {vergangen.map((t) => (
              <li class="bg-white/60 p-4 border border-navy-900/10 text-sm text-navy-900/70">
                <span class="font-semibold">{terminDatum(t.datum)}</span> · {t.titel}{t.ort && ` · ${t.ort}`}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</Base>

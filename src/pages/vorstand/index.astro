---
// Vorstandsbereich — Anmeldung und Übersicht.
//
// Hinter einem gemeinsamen Passwort (VORSTAND_PASSWORT): Kontostand,
// Kennzahlen, neue Anträge und Austritte, die beiden CSV-Exporte und eine
// Vorschau auf Termine und Dokumente. Mitgliederliste, Termine und Dokumente
// haben eigene Seiten (siehe components/VorstandNav.astro).
// Nicht im Suchindex und nirgends verlinkt.
import Base from '../../layouts/Base.astro';
import VorstandNav from '../../components/VorstandNav.astro';
import { VORSTAND, KONTAKT, START, terminDatum, zeitText } from '../../lib/vorstand.ts';
import { anmeldungVerarbeiten, geschuetzt } from '../../lib/zugang.ts';
import { kennzahlen, bewegungen, dokumente, kommendeTermine } from '../../lib/vorstand-db.ts';
import type { Kennzahlen, Bewegung, Dokument, Termin } from '../../lib/vorstand-db.ts';
import { ZAHLWEISE } from '../../lib/export-listen.ts';
import { deDatum } from '../../lib/csv.ts';
import { BEWEGUNGEN_TAGE } from '../../data/vorstand-bereich.ts';
import { getEnv } from '../../lib/zuwendung.ts';
import { uebersicht as kontoUebersicht } from '../../lib/kontostand.ts';
import type { Uebersicht as KontoUebersicht } from '../../lib/kontostand.ts';
import { BANK } from '../../data/bank.ts';

export const prerender = false;

// Nichts hiervon darf in einem Zwischenspeicher landen.
geschuetzt(Astro.response.headers);

const anmeldung = await anmeldungVerarbeiten(
  Astro.request, Astro.cookies, VORSTAND, 'vorstand', START, KONTAKT,
);
if (anmeldung.antwort) return anmeldung.antwort;
const { fehler, abgemeldet } = anmeldung;

const offen = !abgemeldet && VORSTAND.angemeldet(Astro.cookies);

const HINWEISE: Record<string, { text: string; gut?: boolean }> = {
  'bank-falsch': { text: 'Das Bank-Passwort stimmt nicht.' },
  'bank-fehlt': { text: 'Der SEPA-Export ist noch nicht eingerichtet (EXPORT_BANK_PASSWORT fehlt in Vercel).' },
  gesperrt: { text: 'Zu viele Fehlversuche. Bitte warten Sie 15 Minuten.' },
  technik: { text: `Das hat technisch nicht geklappt. Bitte später noch einmal versuchen oder an ${KONTAKT} schreiben.` },
};
const hinweis = offen ? HINWEISE[Astro.url.searchParams.get('hinweis') ?? ''] : undefined;

let zahlen: Kennzahlen | null = null;
let neu: Bewegung[] = [];
let ablage: Dokument[] = [];
let termine: Termin[] = [];
let datenFehler = false;
let konto: KontoUebersicht | null = null;
if (offen) {
  try {
    konto = await kontoUebersicht();
  } catch (e) {
    console.error('Vorstand: Kontostand nicht ladbar —', (e as Error).message);
  }
  try {
    [zahlen, neu, ablage, termine] = await Promise.all([
      kennzahlen(), bewegungen(BEWEGUNGEN_TAGE), dokumente(), kommendeTermine(3),
    ]);
  } catch (e) {
    console.error('Vorstand: Übersicht nicht ladbar —', (e as Error).message);
    datenFehler = true;
  }
}
const antraege = neu.filter((b) => b.art === 'antrag');
const austritte = neu.filter((b) => b.art === 'austritt');
const bankBereit = Boolean(getEnv('EXPORT_BANK_PASSWORT'));

// Rückmeldung nach „Jetzt abrufen“
const KONTO_HINWEISE: Record<string, { text: string; gut?: boolean }> = {
  ok: { text: 'Der Kontostand ist aktualisiert.', gut: true },
  'freigabe-noetig': { text: 'Die Freigabe in der S-pushTAN-App kam nicht rechtzeitig. Bitte erneut auf „Jetzt abrufen“ klicken und die Push-Nachricht innerhalb von 45 Sekunden bestätigen.' },
  'konto-fehlt': { text: 'Das Vereinskonto (FINTS_IBAN) ist in diesem Online-Banking-Zugang nicht zu finden.' },
  'nicht-eingerichtet': { text: 'Der Bankzugang ist noch nicht eingerichtet.' },
  fehler: { text: 'Die Bank hat den Abruf abgelehnt. Details stehen unten im Kasten.' },
};
const kontoHinweis = offen ? KONTO_HINWEISE[Astro.url.searchParams.get('konto') ?? ''] : undefined;
const zeit = (w: string) => new Date(w).toLocaleString('de-DE', {
  timeZone: 'Europe/Berlin', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit',
});
const betrag = (n: number, w: string) => n.toLocaleString('de-DE', { style: 'currency', currency: w || 'EUR' });

const euro = (n: number) => `${n.toLocaleString('de-DE')} €`;

const kachel = 'bg-white p-5 border border-navy-900/10 border-l-4 border-l-pk-yellow';
const feld = 'w-full border border-navy-900/20 px-4 py-3 focus:outline-none focus:border-navy-900';
const label = 'block text-xs font-semibold uppercase tracking-wider text-navy-900/70 mb-1';
---

<Base title="Vorstand" robots="noindex, nofollow" description="Interner Bereich des Vorstands.">

  <section class="bg-cream-50 pt-16 pb-10">
    <div class="container-c max-w-4xl">
      <div class="eyebrow mb-4">Nur für den Vorstand</div>
      <h1 class="text-4xl md:text-5xl font-display font-bold leading-tight">Vorstandsbereich</h1>
      {!offen && (
        <p class="mt-6 text-lg leading-relaxed text-navy-900/80">
          Mitgliederliste, Exporte und Unterlagen des Vorstands. Bitte melden Sie sich
          mit dem gemeinsamen Vorstandspasswort an.
        </p>
      )}
      {offen && (
        <VorstandNav aktiv="start" />
      )}
    </div>
  </section>

  {!offen && (
    <section class="bg-cream-50">
      <div class="container-c border-t border-navy-900/10 py-12 max-w-4xl">
        {abgemeldet && (
          <div class="mb-8 bg-white border border-navy-900/10 border-l-4 border-l-pk-yellow p-5 max-w-md">
            <p class="text-sm leading-relaxed">Sie sind abgemeldet.</p>
          </div>
        )}
        <form method="POST" class="bg-white border border-navy-900/10 p-6 md:p-8 max-w-md">
          <label for="passwort" class="block text-sm font-semibold uppercase tracking-wider text-navy-900/70">
            Vorstandspasswort
          </label>
          <input
            id="passwort" name="passwort" type="password" required
            autocomplete="current-password" autocapitalize="none" autocorrect="off" spellcheck="false"
            aria-describedby={fehler ? 'passwort-fehler' : undefined}
            aria-invalid={fehler ? 'true' : undefined}
            class={`mt-2 text-lg ${feld}`}
          />
          {fehler && (
            <p id="passwort-fehler" role="alert" class="mt-3 text-sm font-semibold" style="color:#c2185b">{fehler}</p>
          )}
          <button type="submit" class="btn-dark mt-6 w-full">Anmelden</button>
        </form>
      </div>
    </section>
  )}

  {offen && (
    <section class="bg-cream-50">
      <div class="container-c border-t border-navy-900/10 py-12 max-w-4xl space-y-16">

        {hinweis && (
          <div role="status" class={`bg-white border border-navy-900/10 border-l-4 p-5 ${hinweis.gut ? 'border-l-pk-yellow' : 'border-l-pk-red'}`}>
            <p class="text-sm leading-relaxed">{hinweis.text}</p>
          </div>
        )}

        {datenFehler && (
          <div role="alert" class="bg-white border-2 border-pk-red p-5">
            <p class="text-sm leading-relaxed">
              Die Daten konnten gerade nicht geladen werden. Bitte die Seite in einer Minute neu laden.
            </p>
          </div>
        )}

        {zahlen && (
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <div class={kachel}>
              <div class="text-xs uppercase tracking-wider text-navy-900/60 font-semibold">Mitglieder</div>
              <div class="mt-2 text-3xl font-display font-bold">{zahlen.aktiv}</div>
            </div>
            <div class={kachel}>
              <div class="text-xs uppercase tracking-wider text-navy-900/60 font-semibold">davon SEPA</div>
              <div class="mt-2 text-3xl font-display font-bold">{zahlen.sepa}</div>
            </div>
            <div class={kachel}>
              <div class="text-xs uppercase tracking-wider text-navy-900/60 font-semibold">Beiträge / Jahr</div>
              <div class="mt-2 text-3xl font-display font-bold">{euro(zahlen.beitraegeJahr)}</div>
            </div>
            <div class={kachel}>
              <div class="text-xs uppercase tracking-wider text-navy-900/60 font-semibold">Ausgetreten</div>
              <div class="mt-2 text-3xl font-display font-bold">{zahlen.ausgetreten}</div>
            </div>
          </div>
        )}
        {zahlen && (
          <p class="-mt-12 text-xs leading-relaxed text-navy-900/60">
            Gezählt werden nur Einträge aus der Online-Erfassung und den Online-Anträgen.
            Mitglieder, die nur in der bisherigen Excel-Liste stehen, fehlen hier.
          </p>
        )}

        <div id="kontostand" class="scroll-mt-24">
          <h2 class="text-2xl font-display font-bold">Kontostand</h2>
          <p class="mt-2 text-sm text-navy-900/60">Vereinskonto bei der {BANK.name}, täglich morgens automatisch abgerufen.</p>

          {kontoHinweis && (
            <div role="status" class={`mt-6 bg-white border border-navy-900/10 border-l-4 p-5 ${kontoHinweis.gut ? 'border-l-pk-yellow' : 'border-l-pk-red'}`}>
              <p class="text-sm leading-relaxed">{kontoHinweis.text}</p>
            </div>
          )}

          <div class="mt-6 bg-white p-6 border border-navy-900/10 border-l-4 border-l-pk-yellow">
            {konto?.stand ? (
              <>
                <div class="text-4xl font-display font-bold">{betrag(konto.stand.saldo, konto.stand.waehrung)}</div>
                <div class="mt-2 text-sm text-navy-900/70">
                  {konto.stand.buchungsdatum && <>Buchungsstand {deDatum(konto.stand.buchungsdatum)} · </>}
                  abgerufen {zeit(konto.stand.abgerufen_am)} Uhr
                  {konto.stand.verfuegbar !== null && konto.stand.verfuegbar !== konto.stand.saldo && (
                    <> · verfügbar {betrag(konto.stand.verfuegbar, konto.stand.waehrung)}</>
                  )}
                </div>
              </>
            ) : (
              <p class="text-sm text-navy-900/70">
                {konto?.eingerichtet ? 'Noch kein Kontostand abgerufen.' : 'Der Bankzugang ist noch nicht eingerichtet (Zugangsdaten fehlen in Vercel).'}
              </p>
            )}

            {konto?.freigabeNoetigSeit && (
              <p class="mt-4 text-sm leading-relaxed font-semibold" style="color:#c2185b">
                Die Bank verlangt eine neue Freigabe (seit {deDatum(konto.freigabeNoetigSeit)}). Der tägliche Abruf
                pausiert, bis jemand mit Zugang zur S-pushTAN-App auf „Jetzt abrufen“ klickt und bestätigt.
              </p>
            )}
            {konto?.letzterFehler && (
              <p class="mt-4 text-xs leading-relaxed text-navy-900/60 break-words">Letzte Meldung der Bank: {konto.letzterFehler}</p>
            )}

            {konto?.eingerichtet && (
              <form method="POST" action="/vorstand/kontostand" class="mt-6 flex flex-wrap items-center gap-4">
                <button type="submit" class="btn-dark">Jetzt abrufen</button>
                <span class="text-xs leading-relaxed text-navy-900/60 max-w-md">
                  Verlangt die Bank eine Freigabe (etwa alle 90 Tage), kommt eine Push-Nachricht in die
                  S-pushTAN-App. Bitte dort bestätigen — die Seite wartet bis zu 45 Sekunden.
                </span>
              </form>
            )}
          </div>
        </div>

        <div id="neu" class="scroll-mt-24">
          <h2 class="text-2xl font-display font-bold">Neue Anträge &amp; Austritte</h2>
          <p class="mt-2 text-sm text-navy-900/60">Die letzten {BEWEGUNGEN_TAGE} Tage, neueste zuerst.</p>

          <div class="mt-6 grid md:grid-cols-2 gap-6">
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wider text-navy-900/70">
                Mitgliedsanträge ({antraege.length})
              </h3>
              {antraege.length === 0 && <p class="mt-3 text-sm text-navy-900/60">Keine neuen Anträge.</p>}
              <ul class="mt-3 space-y-2">
                {antraege.map((b) => (
                  <li class="bg-white p-4 border border-navy-900/10">
                    <div class="flex justify-between gap-3">
                      <span class="font-semibold">{b.vorname} {b.nachname}</span>
                      <span class="text-sm text-navy-900/60 whitespace-nowrap">{deDatum(b.am)}</span>
                    </div>
                    <div class="mt-1 text-sm text-navy-900/70">
                      {b.kind_name && <>Kind: {b.kind_name}{b.klasse && ` (${b.klasse})`} · </>}
                      {euro(b.beitrag_eur)} · {ZAHLWEISE[b.zahlweise] ?? b.zahlweise}
                      {b.mandatsreferenz && <> · {b.mandatsreferenz}</>}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wider text-navy-900/70">
                Austritte ({austritte.length})
              </h3>
              {austritte.length === 0 && <p class="mt-3 text-sm text-navy-900/60">Keine Austritte.</p>}
              <ul class="mt-3 space-y-2">
                {austritte.map((b) => (
                  <li class="bg-white p-4 border border-navy-900/10">
                    <div class="flex justify-between gap-3">
                      <span class="font-semibold">{b.vorname} {b.nachname}</span>
                      <span class="text-sm text-navy-900/60 whitespace-nowrap">{deDatum(b.am)}</span>
                    </div>
                    <div class="mt-1 text-sm text-navy-900/70">
                      {ZAHLWEISE[b.zahlweise] ?? b.zahlweise}
                      {b.mandatsreferenz && <> · {b.mandatsreferenz}</>}
                      {b.zahlweise === 'sepa' && <> · <strong>Einzug beenden</strong></>}
                    </div>
                  </li>
                ))}
              </ul>
              <p class="mt-3 text-xs leading-relaxed text-navy-900/60">
                Austritte von Mitgliedern, die nur in der Excel-Liste stehen, erscheinen hier
                nicht — dazu kommt jeweils eine Mail an den Verein.
              </p>
            </div>
          </div>
        </div>

        <div id="exporte" class="scroll-mt-24">
          <h2 class="text-2xl font-display font-bold">Exporte</h2>
          <p class="mt-2 text-sm text-navy-900/60">CSV-Dateien für Excel (Semikolon, UTF-8).</p>
          <div class="mt-6 grid md:grid-cols-2 gap-6">
            <div class="bg-white p-6 border border-navy-900/10">
              <h3 class="font-semibold">Mitgliederliste</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy-900/70">
                Alle Einträge mit Adresse, Kind, Beitrag und Zahlweise — ohne Bankdaten.
                Ausgetretene sind mit Datum markiert.
              </p>
              <a href="/vorstand/export/mitglieder" class="btn-dark mt-5 w-full" download>Herunterladen</a>
            </div>
            <form method="POST" action="/vorstand/export/sepa" class="bg-white p-6 border border-navy-900/10">
              <h3 class="font-semibold">SEPA-Mandate</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy-900/70">
                Kontoinhaber und IBAN im Klartext, nur aktive Mitglieder mit Lastschrift.
                Braucht zusätzlich das Bank-Passwort.
              </p>
              {bankBereit ? (
                <>
                  <label for="bankpasswort" class={`${label} mt-4`}>Bank-Passwort</label>
                  <input id="bankpasswort" name="bankpasswort" type="password" required
                    autocomplete="off" class={feld} />
                  <button type="submit" class="btn-dark mt-4 w-full">Herunterladen</button>
                </>
              ) : (
                <p class="mt-4 text-sm font-semibold">Noch nicht eingerichtet.</p>
              )}
              <p class="mt-3 text-xs leading-relaxed text-navy-900/60">
                Die Datei enthält Bankdaten. Bitte nach der Einreichung bei der Bank löschen
                und nicht per Mail weitergeben.
              </p>
            </form>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <h2 class="text-2xl font-display font-bold">Nächste Termine</h2>
            {termine.length === 0 && !datenFehler && <p class="mt-4 text-sm text-navy-900/70">Keine Termine eingetragen.</p>}
            <ul class="mt-4 space-y-2">
              {termine.map((t) => (
                <li class="bg-white p-4 border border-navy-900/10 border-l-4 border-l-pk-yellow">
                  <div class="text-xs font-semibold text-gold-600">{terminDatum(t.datum)}{t.uhrzeit && `, ${zeitText(t.uhrzeit)}`}</div>
                  <div class="mt-1 font-semibold">{t.titel}{t.quelle === 'schule' && <span class="ml-2 text-[10px] uppercase tracking-wider px-2 py-0.5 bg-navy-900 text-white align-middle">Schule</span>}</div>
                  {t.ort && <div class="text-sm text-navy-900/70">{t.ort}</div>}
                </li>
              ))}
            </ul>
            <a href="/vorstand/termine/" class="mt-4 inline-block text-sm underline text-navy-900/70 hover:text-navy-900">Alle Termine &amp; neuer Termin →</a>
          </div>
          <div>
            <h2 class="text-2xl font-display font-bold">Neueste Dokumente</h2>
            {ablage.length === 0 && !datenFehler && <p class="mt-4 text-sm text-navy-900/70">Noch keine Dokumente hochgeladen.</p>}
            <ul class="mt-4 space-y-2">
              {ablage.slice(0, 3).map((d) => (
                <li class="bg-white p-4 border border-navy-900/10">
                  <a href={`/vorstand/datei/${d.id}`} class="font-semibold hover:text-gold-600">{d.titel}</a>
                  <div class="text-xs text-navy-900/50">hochgeladen {deDatum(d.hochgeladen_am)}</div>
                </li>
              ))}
            </ul>
            <a href="/vorstand/dokumente/" class="mt-4 inline-block text-sm underline text-navy-900/70 hover:text-navy-900">Alle Dokumente &amp; hochladen →</a>
          </div>
        </div>

        <div class="border-t border-navy-900/10 pt-6 flex flex-wrap items-center gap-4">
          <form method="POST">
            <input type="hidden" name="abmelden" value="1" />
            <button type="submit" class="text-sm underline text-navy-900/60 hover:text-navy-900">Abmelden</button>
          </form>
          <span class="text-sm text-navy-900/50">Die Anmeldung gilt zwölf Stunden.</span>
        </div>
      </div>
    </section>
  )}
</Base>
